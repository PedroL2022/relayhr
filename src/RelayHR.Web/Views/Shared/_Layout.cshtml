<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f7fb" />
    <title>@ViewData["Title"] - RelayHR</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RelayHR.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="header-content">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="RelayHR, inicio">
                <span class="brand-mark" aria-hidden="true">R</span>
                <span>relay<span class="brand-accent">hr</span></span>
            </a>
            <div class="header-context">
                <span class="header-dot" aria-hidden="true"></span>
                Gestión de salidas
            </div>
            <a class="header-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </header>
    <main role="main" class="page-shell">
            @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-content">
            <span>&copy; 2026 RelayHR</span>
            <span>Procesos de salida claros, coordinados y seguros.</span>
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
