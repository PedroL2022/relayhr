{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=RelayHR;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "RelayHR",
    "Audience": "RelayHR.Api"
  },
  "ExpressVacancy": {
    "PollingIntervalSeconds": 10,
    "BatchSize": 20,
    "MaxAttempts": 5,
    "RetryBaseDelaySeconds": 15,
    "MaxRetryDelaySeconds": 120,
    "LeaseSeconds": 120,
    "MaxAvailabilityMinutes": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
