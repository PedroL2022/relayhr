@model VacancyEditViewModel
@{
    var vacancy = Model.Vacancy!;
    ViewData["Title"] = "Vacante Express";
    var missing = vacancy.GetMissingFields();
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">Vacante Express</h1>
        <span class="badge @vacancy.Status.ToBadge() fs-6">@vacancy.Status.ToText()</span>
    </div>
    <a asp-action="Index">&larr; Volver a la bandeja</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div><strong>Originada por la salida de:</strong>
            @if (User.IsInRole(Roles.HRAdmin))
            {
                <a asp-controller="Exits" asp-action="Details" asp-route-id="@vacancy.EmployeeExitId">@vacancy.EmployeeExit.Employee.FullName</a>
            }
            else
            {
                @vacancy.EmployeeExit.Employee.FullName
            }
            (fecha efectiva @vacancy.EmployeeExit.ExitDate.Short())
        </div>
        <div><strong>Generada el:</strong> @vacancy.CreatedAt.Local()</div>
        @if (vacancy.Status == VacancyStatus.Published)
        {
            <div><strong>Publicada por:</strong> @vacancy.PublishedBy el @vacancy.PublishedAt.Local()</div>
            <div>
                <strong>Tiempo desde el registro de la salida:</strong> @vacancy.TimeToPublish!.Value.AsHours()
                @if (vacancy.MetPublishGoal)
                {
                    <span class="badge bg-success">Cumple la meta de menos de @ExpressVacancy.PublishGoalHours horas</span>
                }
                else
                {
                    <span class="badge bg-danger">No cumple la meta de menos de @ExpressVacancy.PublishGoalHours horas</span>
                }
            </div>
        }
    </div>
</div>

@if (vacancy.CanEdit)
{
    @if (missing.Count > 0)
    {
        <div class="alert alert-warning">
            <strong>Campos por completar:</strong> @string.Join(", ", missing). No se puede publicar hasta completarlos.
        </div>
    }

    <form asp-action="Edit" method="post" class="col-md-8">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="ExpressVacancyId" />

        <div class="mb-3">
            <label asp-for="JobTitle" class="form-label"></label>
            <input asp-for="JobTitle" class="form-control" />
            <span asp-validation-for="JobTitle" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DepartmentId" class="form-label"></label>
            <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select">
                <option value="">-- Por completar --</option>
            </select>
        </div>
        <div class="mb-3">
            <label asp-for="JobDescription" class="form-label"></label>
            <textarea asp-for="JobDescription" class="form-control" rows="4"></textarea>
            <span asp-validation-for="JobDescription" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Requirements" class="form-label"></label>
            <textarea asp-for="Requirements" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Requirements" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Guardar cambios</button>
    </form>

    <form asp-action="Publish" asp-route-id="@vacancy.ExpressVacancyId" method="post" class="mt-3"
          onsubmit="return confirm('¿Publicar la vacante? Los candidatos podrán verla.');">
        <button type="submit" class="btn btn-success">Publicar vacante</button>
        <span class="form-text ms-2">Guarda primero tus cambios; se publica lo que está guardado.</span>
    </form>
}
else
{
    <dl class="row">
        <dt class="col-sm-3">Título del puesto</dt><dd class="col-sm-9">@vacancy.JobTitle</dd>
        <dt class="col-sm-3">Departamento</dt><dd class="col-sm-9">@(vacancy.Department?.Name)</dd>
        <dt class="col-sm-3">Descripción</dt><dd class="col-sm-9">@vacancy.JobDescription</dd>
        <dt class="col-sm-3">Requisitos</dt><dd class="col-sm-9">@vacancy.Requirements</dd>
    </dl>
    <a class="btn btn-outline-primary" asp-controller="Jobs" asp-action="Details" asp-route-id="@vacancy.ExpressVacancyId">Ver como candidato</a>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
