@model List<ExpressVacancy>
@{
    ViewData["Title"] = "Vacantes Express";
    var status = ViewBag.Status as VacancyStatus?;
}

<h1 class="h3 mb-3">Bandeja de Vacantes Express</h1>

<ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link @(status is null ? "active" : "")" asp-action="Index">Todas</a></li>
    <li class="nav-item"><a class="nav-link @(status == VacancyStatus.PendingReview ? "active" : "")" asp-action="Index" asp-route-status="PendingReview">Pendientes de revisión</a></li>
    <li class="nav-item"><a class="nav-link @(status == VacancyStatus.InReview ? "active" : "")" asp-action="Index" asp-route-status="InReview">En revisión</a></li>
    <li class="nav-item"><a class="nav-link @(status == VacancyStatus.Published ? "active" : "")" asp-action="Index" asp-route-status="Published">Publicadas</a></li>
</ul>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay vacantes en esta bandeja.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr><th>Puesto</th><th>Departamento</th><th>Salida de</th><th>Estado</th><th>Campos por completar</th><th>Generada</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var vacancy in Model)
            {
                var missing = vacancy.GetMissingFields();
                <tr>
                    <td>
                        @if (string.IsNullOrWhiteSpace(vacancy.JobTitle)) { <span class="badge bg-warning text-dark">Por completar</span> }
                        else { @vacancy.JobTitle }
                    </td>
                    <td>
                        @if (vacancy.Department is null) { <span class="badge bg-warning text-dark">Por completar</span> }
                        else { @vacancy.Department.Name }
                    </td>
                    <td>@vacancy.EmployeeExit.Employee.FullName</td>
                    <td><span class="badge @vacancy.Status.ToBadge()">@vacancy.Status.ToText()</span></td>
                    <td>@(missing.Count == 0 ? "Ninguno" : string.Join(", ", missing))</td>
                    <td>@vacancy.CreatedAt.Local()</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@vacancy.ExpressVacancyId">@(vacancy.CanEdit ? "Revisar" : "Ver")</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
