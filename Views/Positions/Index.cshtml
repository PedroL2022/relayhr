@model List<Position>
@{
    ViewData["Title"] = "Puestos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Puestos</h1>
    <a class="btn btn-primary" asp-action="Create">Nuevo puesto</a>
</div>

<p class="text-muted">
    Con estos datos se genera la Vacante Express cuando un empleado se va.
    Lo que falte aquí aparecerá como «por completar» en la vacante.
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Todavía no hay puestos registrados.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr><th>Puesto</th><th>Departamento</th><th>Descripción</th><th>Requisitos</th></tr>
            </thead>
            <tbody>
            @foreach (var position in Model)
            {
                <tr>
                    <td>@position.Title</td>
                    <td>@(position.Department?.Name ?? "—")</td>
                    <td>
                        @if (string.IsNullOrWhiteSpace(position.Description)) { <span class="badge bg-warning text-dark">Por completar</span> }
                        else { @position.Description }
                    </td>
                    <td>
                        @if (string.IsNullOrWhiteSpace(position.Requirements)) { <span class="badge bg-warning text-dark">Por completar</span> }
                        else { @position.Requirements }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
