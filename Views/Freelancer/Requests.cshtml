@model List<ServiceRequest>
@{
    ViewData["Title"] = "Solicitudes recibidas";
}

<h1 class="h3 mb-3">Solicitudes recibidas</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Todavía no has recibido solicitudes de servicio.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr><th>Empresa</th><th>Enviada por</th><th>Recibida</th><th>Estado</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var request in Model)
            {
                <tr>
                    <td>@request.CompanyName</td>
                    <td>@request.RequestedBy.FullName</td>
                    <td>@request.CreatedAt.Local()</td>
                    <td><span class="badge @request.Status.ToBadge()">@request.Status.ToText()</span></td>
                    <td class="text-end">
                        @if (request.Status == ServiceRequestStatus.Sent)
                        {
                            <form asp-action="Respond" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@request.ServiceRequestId" />
                                <input type="hidden" name="accept" value="true" />
                                <button type="submit" class="btn btn-sm btn-success">Aceptar</button>
                            </form>
                            <form asp-action="Respond" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@request.ServiceRequestId" />
                                <input type="hidden" name="accept" value="false" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Rechazar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
