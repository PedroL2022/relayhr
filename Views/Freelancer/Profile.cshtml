@model FreelancerProfileViewModel
@{
    ViewData["Title"] = "Mi perfil";
}

<h1 class="h3 mb-3">Mi perfil de trabajador independiente</h1>

<p class="text-muted">Las empresas verán esta información en el directorio de talento interino.</p>

<form asp-action="Profile" method="post" class="col-md-8">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category" class="form-select">
            <option value="">-- Selecciona --</option>
            @foreach (var category in FreelancerCategories.All)
            {
                <option value="@category">@category</option>
            }
        </select>
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ExperienceYears" class="form-label"></label>
        <input asp-for="ExperienceYears" type="number" min="0" max="60" class="form-control" />
        <span asp-validation-for="ExperienceYears" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ExperienceSummary" class="form-label"></label>
        <textarea asp-for="ExperienceSummary" class="form-control" rows="4"></textarea>
        <span asp-validation-for="ExperienceSummary" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PortfolioUrl" class="form-label"></label>
        <input asp-for="PortfolioUrl" class="form-control" placeholder="https://" />
        <span asp-validation-for="PortfolioUrl" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="HourlyRate" class="form-label"></label>
        <input asp-for="HourlyRate" type="number" min="1" step="0.01" class="form-control" />
        <span asp-validation-for="HourlyRate" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsAvailable" class="form-check-input" />
        <label asp-for="IsAvailable" class="form-check-label"></label>
    </div>
    <div class="mb-3">
        <label asp-for="AvailabilityNote" class="form-label"></label>
        <input asp-for="AvailabilityNote" class="form-control" />
        <span asp-validation-for="AvailabilityNote" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar perfil</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
